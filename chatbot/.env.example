# Copy this file to chatbot/.env and fill in your key. Never commit .env.

# Which AI to use: gemini (free tier) or anthropic
LLM_PROVIDER=gemini

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Freeze "today" for the demo so the Halloween example has valid deadlines.
# Leave empty to use the real date.
DEMO_TODAY=2026-10-01
# 8787 so it doesn't clash with Next.js / Vite dev servers on 3000/5173
PORT=8787

# Rooms come from Amitesh's file on GitHub, re-checked every 90 seconds
# (GitHub allows 60 unauthenticated checks per hour; unchanged files are cheap).
# ROOMS_SOURCE=github            (default when running outside the repo; use "local" to force the local file)
# ROOMS_GITHUB_REPO=c-rliang/Room-Booking-Website
# ROOMS_GITHUB_REF=feature/room-heatmap      (change to main after the heatmap branch is merged)
# ROOMS_GITHUB_PATH=web/src/data/rooms.json
# ROOMS_REFRESH_SECONDS=90
# GITHUB_TOKEN=            (optional, only if you hit the rate limit)
# Or use a local file instead (turns GitHub sync off):
# ROOMS_FILE=data/rooms.sample.json

# Optional: let the team's front end (another dev server) call the chatbot. Comma-separated.
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
